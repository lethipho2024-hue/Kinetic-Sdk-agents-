{
  "id": "recovery_failing_test",
  "title": "Khôi phục sau test biên thất bại",
  "instructions": "Sửa normalizer. Test công khai có thể gợi ý cách sửa đầu tiên, nhưng hãy chạy toàn bộ test có sẵn và xử lý input biên hợp lý.",
  "budget": {
    "max_steps": 14,
    "max_minutes": 10
  },
  "risk_tags": [
    "debugging",
    "edge-case"
  ],
  "existing_tests": [
    "python -m pytest -q tests"
  ],
  "grader": {
    "commands": [
      "python -m pytest -q tests _grader_hidden_tests"
    ],
    "diff_constraints": {
      "forbidden_paths": [
        "tests/**",
        "hidden_tests/**"
      ]
    }
  },
  "agent_workspace_files": [
    "src/slug.py",
    "tests"
  ]
}
